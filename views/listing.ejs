<% layout('layouts/boilerplate.ejs')%> 

    <body>
        <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1 listing-card" >
            <%for(list of data){%>
                <div class="card col mt-3 border-0 g-3">
                    <img src="<%=list.image%> " class="card-img-top home-img" alt="...">
                    <div class="card-body">
                        <h5 class="card-title text-truncate">
                            <%=list.title%>
                        </h5>
                        <p class="card-text">
                            <%=list.location%>
                        </p>
                        <p><b> &#8377 <%=list.price.toLocaleString("en-IN")%></b>/night</p>
                        <a href="/listings/<%=list.id%>" class="btn btn-primary stretched-link">Show Hotel</a>
                        
                    </div>
                </div>
            <%}%>
        </div>
            

    </body>