<% layout('layouts/boilerplate.ejs')%>

    <body>

        <div class="card row pt-3 ">
            <div class="col-8 offset-3">
                <h2>
                    <%=data.title%>
                </h2>
            </div>
            <div class=" col-6 offset-3 ">
                <img src="<%=data.image%>" class="card-img-top show-img" alt="...">
                <br>
            </div>

            <div class="card-body col-8 offset-2">

                <p class="card-text">
                    Owned by - <b>
                        <%=data.owner.username%>
                    </b>
                </p>

                <p class="card-text">
                    <b> &#8377 <%=data.price.toLocaleString("en-IN")%></b>/night
                </p>

                <p class="card-text">
                    <%=data.description%>
                </p>

                <p class="card-text">
                    <%=data.location%>
                </p>

                <p class="card-text">
                    <%=data.country%>
                </p>

            </div>

        </div>
        <%if(currUser && currUser._id.equals(data.owner._id)){%>
            <div class="col-4 offset-4 show-btns">
                <a href="/listings/<%=data._id%>/edit" class="btn"><button>Update Listing</button></a>
                <a href="/listings/<%=data._id%>/delete" class="btn"><button>Delete Listing</button></a>
            </div>
            <%}%>
                <br>
                <hr>
                <div>
                    <%if(currUser){%>
                        <form action="/listings/<%=data._id%>/review" method="post" class="form-label needs-validation"
                            novalidate>
                            <fieldset class="starability-slot">
                                <h4>Ratings</h4>
                                <input type="radio" id="rate1" name="review[ratings]" value="1" />
                                <label for="rate1" title="Terrible">1 star</label>
                                <input type="radio" id="rate2" name="review[ratings]" value="2" />
                                <label for="rate2" title="Not good">2 stars</label>
                                <input type="radio" id="rate3" name="review[ratings]" value="3" checked />
                                <label for="rate3" title="Average">3 stars</label>
                                <input type="radio" id="rate4" name="review[ratings]" value="4" />
                                <label for="rate4" title="Very good">4 stars</label>
                                <input type="radio" id="rate5" name="review[ratings]" value="5" />
                                <label for="rate5" title="Amazing">5 stars</label>
                            </fieldset>
                            <div>
                                <h5>Comments</h5>
                                <textarea required name="review[comment]" id="comments" rows="5" cols="10"
                                    placeholder="Write a Review" class="form-control"></textarea>
                                <div class="invalid-feedback">Please write a review before submitting</div>
                            </div>
                            <button type="submit">Submit</button>
                        </form>
                        <hr>
                        <%}%>
                </div>

                <div>
                    <h3 class="ms-3">Reviews from our Visitors</h3>
                    <div class="row">
                        <%for (review of data.review){%>
                            <div class="card mb-3 col-5 ms-5">
                                <div class="card-body">
                                    <h4 class="card-title">Review By - "<%= review.author ? review.author.username
                                            : "Anonymous" %>"</h4>
                                    <p class="card-text">
                                        <%=review.comment%>
                                    </p>
                                    <p class="starability-result card-text" data-rating="<%=review.ratings%>">
                                    </p>
                                    <span class="opacity-50 fs-5">Rated: <%= review.ratings %> stars</span>
                                    <%if(currUser && currUser._id.equals(review.author._id)){%>
                                        <form action="/listings/<%=data._id%>/review/<%=review._id%>?_method=DELETE"
                                            method="post">
                                            <button class="btn btn-sm btn-dark">Delete</button>
                                        </form>
                                        <%}%>
                                </div>
                            </div>
                            <%}%>
                    </div>
                </div>
    </body>