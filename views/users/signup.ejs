<% layout('layouts/boilerplate.ejs')%>

    <div class="row mt-3">
        <h2 class="col-6 offset-3">Signup on Airbnb</h2>
        <div class="col-6 offset-3">

            <form action="/signup" method="post" class="needs-validation" novalidate>

                <div class="mb-3">
                    <label for="username" class="form-label">Username : </label>
                    <input type="text" name="username" id="username" placeholder="Add Username" class="form-control" required>
                    <div class="valid-feedback">Username looks good!</div>
                    <div class="invalid-feedback">Username is invalid</div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">Email : </label>
                    <input type="text" name="email" id="email" placeholder="Add Email" class="form-control" required>
                    <div class="valid-feedback">Email looks good!</div>
                    <div class="invalid-feedback">Email is invalid</div>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password : </label>
                    <input type="password" name="password" id="password" placeholder="Password :" class="form-control" required>
                    <div class="valid-feedback">Password looks good!</div>
                    <div class="invalid-feedback">Password is invalid</div>
                </div>

                <button type="submit" class="btn btn-dark">Signup</button>

            </form>

        </div>
    </div>